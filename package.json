{
  "name": "Portfolio",
  "version": "1.0.0",
  "author": {
    "name": "Marco Antonio Figueroa Sanchez",
    "email": "marco@figueroa-sanchez.com"
  },
  "scripts": {
    "ng": "ng",
    "start": "node scripts/ng.mjs serve",
    "build": "node scripts/ng.mjs build",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"src/**/*.ts\" \"docker/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"docker/**/*.mjs\" \"scripts/**/*.mjs\"",
    "lint": "oxlint --type-aware src/",
    "test": "ng test",
    "test:cov": "ng test --watch=false --coverage",
    "check:csp": "bash scripts/check-ssr-csp.sh",
    "approve-builds": "pnpm approve-builds"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^6.4.299",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
